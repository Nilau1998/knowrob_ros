{
  "logging": {
    "console-sink": {
      "level": "debug"
    },
    "file-sink": {
      "path": "log/knowrob.log",
      "level": "debug"
    }
  },
  "data-sources": [
    {
      "path": "/ros2_ws/owl/cmecs.owl",
      "language": "owl",
      "format": "xml"
    }
  ],
  "data-backends": [
    {
      "type": "MongoDB",
      "name": "mongodb",
      "host": "mongo",
      "port": 27017,
      "db": "test",
      "read-only": false
    }
  ],
  "reasoner": [
    {
      "name": "mongolog_reasoner",
      "type": "Mongolog",
      "data-backend": "mongodb",
      "imports": [
        {
          "path": "/ros2_ws/src/knowrob_ros/tests/prolog/mongolog_lpn.pl",
          "format": "prolog"
        }
      ]
    }
  ]
}